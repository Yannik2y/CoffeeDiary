# App Store Connect API Key (never commit the real .env or .p8 file)
# Create key: https://appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API
# Role: App Manager or Admin

ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Optional: override App Store Connect app name for deliver
# APP_STORE_CONNECT_APP_NAME=Coffee Diary
