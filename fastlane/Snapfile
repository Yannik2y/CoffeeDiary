# frozen_string_literal: true

# Defaults; Fastfile lanes override devices and run iPhone / iPad separately.
devices([
  "iPhone 16 Pro Max"
])

languages([
  "de-DE"
])

scheme("CoffeeDiary")

output_directory("./fastlane/screenshots/raw")

clear_previous_screenshots(true)

# Status-bar override can contribute to AX load timeouts on some Simulator hosts.
override_status_bar(false)

# App launch args for demo store + light UI. SnapshotHelper also injects FASTLANE_SNAPSHOT.
launch_arguments([
  "--snapshot",
  "-AppleInterfaceStyle",
  "Light"
])

concurrent_simulators(false)

stop_after_first_error(true)

erase_simulator(false)

headless(false)

number_of_retries(2)
