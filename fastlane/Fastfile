# frozen_string_literal: true

ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

require "dotenv"
require "fileutils"
require "shellwords"
Dotenv.load(".env") if File.exist?(".env")

# Fastlane may run with cwd = project root OR ./fastlane. Anchor all screenshot paths
# to this Fastfile so globs never miss PNGs.
SCREENSHOTS_ROOT = File.expand_path("screenshots", __dir__)
SCREENSHOTS_LOCALE = File.join(SCREENSHOTS_ROOT, "de-DE")

default_platform(:ios)

platform :ios do
  desc "Print how to use Xcode Cloud + Fastlane together"
  lane :beta do
    UI.message("Xcode Cloud builds and uploads to TestFlight.")
    UI.message("After the build is processed in App Store Connect, run: bundle exec fastlane release")
  end

  desc "Upload metadata, attach latest processed build, submit for App Review"
  lane :release do
    ensure_asc_env!

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    )
  end

  desc "Dry-run: push metadata only (no submit for review)"
  lane :metadata do
    ensure_asc_env!

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Capture iPhone App Store screenshots only (de-DE)"
  lane :screenshots_iphone do
    prepare_snapshot_environment!
    begin
      capture_device_screenshots!(
        device: "iPhone 16 Pro Max",
        clear_previous: true
      )
      ensure_device_pngs!(device_matcher: /iPhone/i)
      UI.success("iPhone screenshots captured. Run screenshots_ipad or full screenshots to finish.")
    ensure
      cleanup_snapshot_force_marker!
    end
  end

  desc "Capture iPad App Store screenshots only (de-DE)"
  lane :screenshots_ipad do
    prepare_snapshot_environment!
    begin
      capture_device_screenshots!(
        device: "iPad Pro 13-inch (M4)",
        clear_previous: false
      )
      ensure_device_pngs!(device_matcher: /iPad/i)
      UI.success("iPad screenshots captured.")
    ensure
      cleanup_snapshot_force_marker!
    end
  end

  desc "Capture iPhone then iPad screenshots, frame, and size for App Store (de-DE)"
  lane :screenshots do
    prepare_snapshot_environment!
    begin
      UI.header("1/2 iPhone 16 Pro Max")
      capture_device_screenshots!(
        device: "iPhone 16 Pro Max",
        clear_previous: true
      )
      ensure_device_pngs!(device_matcher: /iPhone/i)

      UI.header("2/2 iPad Pro 13-inch (M4)")
      capture_device_screenshots!(
        device: "iPad Pro 13-inch (M4)",
        clear_previous: false
      )
      ensure_device_pngs!(device_matcher: /iPad/i)

      UI.header("Framing & App Store sizes")
      frame_and_fit_screenshots!

      count = locale_screenshot_pngs.size
      UI.success("#{count} screenshots ready under #{SCREENSHOTS_ROOT}. Upload with: bundle exec fastlane screenshots_upload")
    ensure
      cleanup_snapshot_force_marker!
    end
  end

  desc "Frame existing screenshots and fit to App Store pixel sizes (no capture)"
  lane :screenshots_frame do
    ensure_imagemagick!
    pngs = locale_screenshot_pngs
    if pngs.empty?
      UI.user_error!(
        "No screenshots in #{SCREENSHOTS_LOCALE}/. Capture first " \
        "(pwd=#{Dir.pwd})."
      )
    end

    UI.header("Framing & App Store sizes")
    UI.message("Framing #{pngs.size} PNGs from #{SCREENSHOTS_LOCALE}")
    frame_and_fit_screenshots!

    count = locale_screenshot_pngs.size
    UI.success("#{count} marketing screenshots ready. Preview in Finder, then: bundle exec fastlane screenshots_upload")
  end

  desc "Replace App Store Connect screenshots for the current version (de-DE only)"
  lane :screenshots_upload do
    ensure_asc_env!

    pngs = locale_screenshot_pngs
    UI.user_error!("No screenshots found in #{SCREENSHOTS_LOCALE}. Run screenshots / screenshots_frame first.") if pngs.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: SCREENSHOTS_ROOT,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  private_lane :frame_and_fit_screenshots! do
    ensure_frameit_assets!

    frames_dir = File.expand_path("~/.fastlane/frameit/latest")
    unless File.directory?(frames_dir) && Dir.glob(File.join(frames_dir, "Apple iPhone 16 Pro Max*.png")).any?
      UI.important("Downloading device frames for frameit (one-time)…")
      sh("bundle exec fastlane frameit download_frames")
    end

    frameit(path: SCREENSHOTS_ROOT)
    promote_framed_screenshots
    fit_screenshots_to_app_store_sizes
  end

  private_lane :ensure_frameit_assets! do
    bg = File.join(SCREENSHOTS_ROOT, "background.png")
    unless File.exist?(bg)
      tool = `which magick`.strip
      tool = `which convert`.strip if tool.empty?
      sh("#{tool} -size 2000x4000 xc:'#F5EDE4' #{bg.shellescape}")
    end

    fonts = File.join(SCREENSHOTS_ROOT, "fonts")
    FileUtils.mkdir_p(fonts)
    dest = File.join(fonts, "Arial-Bold.ttf")
    src = "/System/Library/Fonts/Supplemental/Arial Bold.ttf"
    FileUtils.cp(src, dest) if File.exist?(src) && !File.exist?(dest)
  end

  private_lane :prepare_snapshot_environment! do
    ensure_imagemagick!

    ENV["DEVELOPER_DIR"] = "/Applications/Xcode.app/Contents/Developer"
    ENV["PATH"] = "#{ENV['DEVELOPER_DIR']}/usr/bin:#{ENV['PATH']}"
    ENV["FASTLANE_SNAPSHOT"] = "YES"
    ENV["SNAPSHOT_FORCE"] = "YES"
    # Slow Macs: wait longer before status-bar override / tests.
    ENV["SNAPSHOT_SIMULATOR_WAIT_FOR_BOOT_TIMEOUT"] ||= "120"

    cache = File.expand_path("~/Library/Caches/tools.fastlane")
    FileUtils.mkdir_p(cache)
    File.write(File.join(cache, "language.txt"), "de-DE\n")
    File.write(File.join(cache, "locale.txt"), "de_DE\n")
    File.write(File.join(cache, "SNAPSHOT_FORCE"), "YES\n")

    # Bring Simulator.app up so Accessibility / AX can initialize more reliably.
    sh("open -a Simulator || true")
    sleep(3)
  end

  private_lane :cleanup_snapshot_force_marker! do
    marker = File.expand_path("~/Library/Caches/tools.fastlane/SNAPSHOT_FORCE")
    FileUtils.rm_f(marker)
  end

  private_lane :capture_device_screenshots! do |options|
    device = options.fetch(:device)
    clear_previous = options.fetch(:clear_previous)

    snapshot(
      scheme: "CoffeeDiary",
      languages: ["de-DE"],
      devices: [device],
      output_directory: SCREENSHOTS_ROOT,
      clear_previous_screenshots: clear_previous,
      override_status_bar: true,
      stop_after_first_error: true,
      concurrent_simulators: false,
      erase_simulator: false,
      headless: false,
      number_of_retries: 2,
      launch_arguments: ["--snapshot", "-AppleInterfaceStyle", "Light"],
      only_testing: ["CoffeeDiaryUITests/SnapshotTests/testAppStoreScreenshots"]
    )
  end

  private_lane :ensure_device_pngs! do |options|
    matcher = options.fetch(:device_matcher)
    pngs = locale_screenshot_pngs.select { |p| File.basename(p).match?(matcher) }
    expected = options.fetch(:expected_count, 4)
    if pngs.empty?
      UI.user_error!(
        "No screenshots matched #{matcher} in #{SCREENSHOTS_LOCALE}. " \
        "SnapshotTests was likely skipped or the Simulator timed out. " \
        "Open Simulator.app, boot the device once, then retry."
      )
    end
    if pngs.size < expected
      UI.user_error!(
        "Expected at least #{expected} screenshots for #{matcher.inspect}, found #{pngs.size}: " \
        "#{pngs.map { |p| File.basename(p) }.join(', ')}. " \
        "Fix SnapshotTests navigation (often iPad tabs after detail) and re-run."
      )
    end
    UI.message("Found #{pngs.size} screenshots for #{matcher.inspect}")
  end

  def locale_screenshot_pngs
    Dir[File.join(SCREENSHOTS_LOCALE, "*.png")]
  end

  private_lane :ensure_asc_env! do
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |k| ENV[k].to_s.strip.empty? }
    UI.user_error!("Missing ENV: #{missing.join(', ')}. Copy .env.example to .env and fill in values.") unless missing.empty?

    path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    UI.user_error!("ASC key file not found: #{path}") unless File.exist?(path)
  end

  private_lane :ensure_imagemagick! do
    magick = `which magick`.strip
    convert = `which convert`.strip
    UI.user_error!("ImageMagick required for frameit. Install with: brew install imagemagick") if magick.empty? && convert.empty?
  end

  # frameit writes *_framed.png beside originals — keep framed as the deliverables.
  private_lane :promote_framed_screenshots do
    Dir.glob(File.join(SCREENSHOTS_ROOT, "**", "*_framed.png")).each do |framed|
      original = framed.sub(/_framed\.png\z/, ".png")
      FileUtils.rm_f(original)
      FileUtils.mv(framed, original)
      UI.message("Using framed screenshot: #{original}")
    end
  end

  # Apple requires exact pixel sizes; framed images are letterboxed into accepted canvases.
  private_lane :fit_screenshots_to_app_store_sizes do
    iphone_size = [1320, 2868]
    ipad_size = [2064, 2752]
    background = "#F5EDE4"

    Dir.glob(File.join(SCREENSHOTS_ROOT, "**", "*.png")).each do |path|
      next if File.basename(path).start_with?(".")

      target =
        if path.match?(/iPad/i)
          ipad_size
        elsif path.match?(/iPhone/i)
          iphone_size
        else
          UI.important("Skipping size fit (unknown device): #{path}")
          next
        end

      width, height = target
      tool = `which magick`.strip
      tool = `which convert`.strip if tool.empty?
      cmd = [
        tool,
        path.shellescape,
        "-resize", "#{width}x#{height}",
        "-background", background.shellescape,
        "-gravity", "center",
        "-extent", "#{width}x#{height}",
        path.shellescape
      ].join(" ")
      sh(cmd)
      UI.message("Fitted #{File.basename(path)} → #{width}x#{height}")
    end
  end
end
