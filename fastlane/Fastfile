# frozen_string_literal: true

ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

require "dotenv"
require "fileutils"
require "shellwords"
Dotenv.load(".env") if File.exist?(".env")

# Fastlane may run with cwd = project root OR ./fastlane. Anchor paths to this Fastfile.
SCREENSHOTS_ROOT = File.expand_path("screenshots", __dir__)
# Raw captures (never overwrite with framed images — prevents double bezels).
SCREENSHOTS_RAW = File.join(SCREENSHOTS_ROOT, "raw")
SCREENSHOTS_RAW_LOCALE = File.join(SCREENSHOTS_RAW, "de-DE")
# Framed + sized App Store deliverables for deliver/upload.
SCREENSHOTS_STORE = File.join(SCREENSHOTS_ROOT, "store")
SCREENSHOTS_STORE_LOCALE = File.join(SCREENSHOTS_STORE, "de-DE")

default_platform(:ios)

platform :ios do
  desc "Print how to use Xcode Cloud + Fastlane together"
  lane :beta do
    UI.message("Xcode Cloud builds and uploads to TestFlight.")
    UI.message("After the build is processed in App Store Connect, run: bundle exec fastlane release")
  end

  desc "Upload metadata, attach latest processed build, submit for App Review"
  lane :release do
    ensure_asc_env!

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true
      }
    )
  end

  desc "Dry-run: push metadata only (no submit for review)"
  lane :metadata do
    ensure_asc_env!

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Capture iPhone App Store screenshots only (de-DE)"
  lane :screenshots_iphone do
    prepare_snapshot_environment!
    begin
      capture_device_screenshots!(
        device: "iPhone 16 Pro Max",
        clear_previous: true
      )
      ensure_device_pngs!(device_matcher: /iPhone/i)
      UI.success("iPhone raw screenshots in #{SCREENSHOTS_RAW_LOCALE}. Run screenshots_ipad or screenshots_frame next.")
    ensure
      cleanup_snapshot_force_marker!
    end
  end

  desc "Capture iPad App Store screenshots only (de-DE)"
  lane :screenshots_ipad do
    prepare_snapshot_environment!
    begin
      capture_device_screenshots!(
        device: "iPad Pro 13-inch (M4)",
        clear_previous: false
      )
      ensure_device_pngs!(device_matcher: /iPad/i)
      UI.success("iPad raw screenshots in #{SCREENSHOTS_RAW_LOCALE}.")
    ensure
      cleanup_snapshot_force_marker!
    end
  end

  desc "Capture iPhone then iPad screenshots, frame, and size for App Store (de-DE)"
  lane :screenshots do
    prepare_snapshot_environment!
    begin
      UI.header("1/2 iPhone 16 Pro Max")
      capture_device_screenshots!(
        device: "iPhone 16 Pro Max",
        clear_previous: true
      )
      ensure_device_pngs!(device_matcher: /iPhone/i)

      UI.header("2/2 iPad Pro 13-inch (M4)")
      capture_device_screenshots!(
        device: "iPad Pro 13-inch (M4)",
        clear_previous: false
      )
      ensure_device_pngs!(device_matcher: /iPad/i)

      UI.header("Framing & App Store sizes")
      frame_and_fit_screenshots!

      count = store_screenshot_pngs.size
      UI.success("#{count} screenshots ready under #{SCREENSHOTS_STORE}. Upload with: bundle exec fastlane screenshots_upload")
    ensure
      cleanup_snapshot_force_marker!
    end
  end

  desc "Frame raw screenshots into store/ (never re-frames store deliverables)"
  lane :screenshots_frame do
    ensure_imagemagick!
    pngs = raw_screenshot_pngs
    if pngs.empty?
      UI.user_error!(
        "No raw screenshots in #{SCREENSHOTS_RAW_LOCALE}/. Capture first with screenshots_iphone / screenshots_ipad."
      )
    end

    UI.header("Framing & App Store sizes")
    UI.message("Framing #{pngs.size} raw PNGs → #{SCREENSHOTS_STORE_LOCALE}")
    frame_and_fit_screenshots!

    count = store_screenshot_pngs.size
    UI.success("#{count} marketing screenshots ready. Preview #{SCREENSHOTS_STORE_LOCALE}, then: bundle exec fastlane screenshots_upload")
  end

  desc "Replace App Store Connect screenshots for the current version (de-DE only)"
  lane :screenshots_upload do
    ensure_asc_env!

    pngs = store_screenshot_pngs
    UI.user_error!("No store screenshots in #{SCREENSHOTS_STORE_LOCALE}. Run screenshots_frame first.") if pngs.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200,
      in_house: false
    )

    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: SCREENSHOTS_STORE,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  private_lane :frame_and_fit_screenshots! do
    ensure_frameit_assets!
    ensure_raw_title_strings!

    frames_dir = File.expand_path("~/.fastlane/frameit/latest")
    unless File.directory?(frames_dir) && Dir.glob(File.join(frames_dir, "Apple iPhone 16 Pro Max*.png")).any?
      UI.important("Downloading device frames for frameit (one-time)…")
      sh("bundle exec fastlane frameit download_frames")
    end

    # Only frame raw captures — never the store/ folder (avoids nested bezels).
    FileUtils.rm_f(Dir[File.join(SCREENSHOTS_RAW_LOCALE, "*_framed.png")])
    frameit(path: SCREENSHOTS_RAW)
    copy_framed_and_raw_to_store!
    fit_screenshots_to_app_store_sizes
  end

  private_lane :ensure_frameit_assets! do
    bg = File.join(SCREENSHOTS_ROOT, "background.png")
    unless File.exist?(bg)
      tool = `which magick`.strip
      tool = `which convert`.strip if tool.empty?
      sh("#{tool} -size 2000x4000 xc:'#F5EDE4' #{bg.shellescape}")
    end

    fonts = File.join(SCREENSHOTS_ROOT, "fonts")
    FileUtils.mkdir_p(fonts)
    dest = File.join(fonts, "Arial-Bold.ttf")
    src = "/System/Library/Fonts/Supplemental/Arial Bold.ttf"
    FileUtils.cp(src, dest) if File.exist?(src) && !File.exist?(dest)
  end

  private_lane :ensure_raw_title_strings! do
    FileUtils.mkdir_p(SCREENSHOTS_RAW_LOCALE)
    dest = File.join(SCREENSHOTS_RAW_LOCALE, "title.strings")
    next if File.exist?(dest)

    legacy = File.join(SCREENSHOTS_ROOT, "de-DE", "title.strings")
    if File.exist?(legacy)
      FileUtils.cp(legacy, dest)
    else
      File.write(dest, <<~STRINGS)
        "01Diary" = "Jeder Bezug, festgehalten";
        "02Detail" = "Dosis, Zeit, Verhältnis";
        "03Stats" = "Trends auf einen Blick";
        "04Gear" = "Deine Ausrüstung";
      STRINGS
    end
  end

  private_lane :prepare_snapshot_environment! do
    ensure_imagemagick!
    FileUtils.mkdir_p(SCREENSHOTS_RAW_LOCALE)

    ENV["DEVELOPER_DIR"] = "/Applications/Xcode.app/Contents/Developer"
    ENV["PATH"] = "#{ENV['DEVELOPER_DIR']}/usr/bin:#{ENV['PATH']}"
    ENV["FASTLANE_SNAPSHOT"] = "YES"
    ENV["SNAPSHOT_FORCE"] = "YES"
    ENV["SNAPSHOT_SIMULATOR_WAIT_FOR_BOOT_TIMEOUT"] ||= "120"

    cache = File.expand_path("~/Library/Caches/tools.fastlane")
    FileUtils.mkdir_p(cache)
    File.write(File.join(cache, "language.txt"), "de-DE\n")
    File.write(File.join(cache, "locale.txt"), "de_DE\n")
    File.write(File.join(cache, "SNAPSHOT_FORCE"), "YES\n")

    sh("open -a Simulator || true")
    sleep(3)
  end

  private_lane :cleanup_snapshot_force_marker! do
    marker = File.expand_path("~/Library/Caches/tools.fastlane/SNAPSHOT_FORCE")
    FileUtils.rm_f(marker)
  end

  private_lane :capture_device_screenshots! do |options|
    device = options.fetch(:device)
    clear_previous = options.fetch(:clear_previous)

    snapshot(
      scheme: "CoffeeDiary",
      languages: ["de-DE"],
      devices: [device],
      output_directory: SCREENSHOTS_RAW,
      clear_previous_screenshots: clear_previous,
      override_status_bar: true,
      stop_after_first_error: true,
      concurrent_simulators: false,
      erase_simulator: false,
      headless: false,
      number_of_retries: 2,
      launch_arguments: ["--snapshot", "-AppleInterfaceStyle", "Light"],
      only_testing: ["CoffeeDiaryUITests/SnapshotTests/testAppStoreScreenshots"]
    )
  end

  private_lane :ensure_device_pngs! do |options|
    matcher = options.fetch(:device_matcher)
    pngs = raw_screenshot_pngs.select { |p| File.basename(p).match?(matcher) }
    expected = options.fetch(:expected_count, 4)
    if pngs.empty?
      UI.user_error!(
        "No screenshots matched #{matcher} in #{SCREENSHOTS_RAW_LOCALE}. " \
        "SnapshotTests was likely skipped or the Simulator timed out."
      )
    end
    if pngs.size < expected
      UI.user_error!(
        "Expected at least #{expected} screenshots for #{matcher.inspect}, found #{pngs.size}: " \
        "#{pngs.map { |p| File.basename(p) }.join(', ')}."
      )
    end
    UI.message("Found #{pngs.size} raw screenshots for #{matcher.inspect}")
  end

  def raw_screenshot_pngs
    Dir[File.join(SCREENSHOTS_RAW_LOCALE, "*.png")].reject { |p| p.include?("_framed") }
  end

  def store_screenshot_pngs
    Dir[File.join(SCREENSHOTS_STORE_LOCALE, "*.png")]
  end

  private_lane :ensure_asc_env! do
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |k| ENV[k].to_s.strip.empty? }
    UI.user_error!("Missing ENV: #{missing.join(', ')}. Copy .env.example to .env and fill in values.") unless missing.empty?

    path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    UI.user_error!("ASC key file not found: #{path}") unless File.exist?(path)
  end

  private_lane :ensure_imagemagick! do
    magick = `which magick`.strip
    convert = `which convert`.strip
    UI.user_error!("ImageMagick required for frameit. Install with: brew install imagemagick") if magick.empty? && convert.empty?
  end

  # Copy framed (or raw if unframed) into store/ — leave raw captures untouched.
  private_lane :copy_framed_and_raw_to_store! do
    FileUtils.mkdir_p(SCREENSHOTS_STORE_LOCALE)
    FileUtils.rm_f(Dir[File.join(SCREENSHOTS_STORE_LOCALE, "*.png")])

    framed = Dir.glob(File.join(SCREENSHOTS_RAW_LOCALE, "*_framed.png"))
    framed.each do |path|
      dest = File.join(SCREENSHOTS_STORE_LOCALE, File.basename(path).sub(/_framed\.png\z/, ".png"))
      FileUtils.cp(path, dest)
      FileUtils.rm_f(path)
      UI.message("Store framed: #{File.basename(dest)}")
    end

    raw_screenshot_pngs.each do |raw|
      dest = File.join(SCREENSHOTS_STORE_LOCALE, File.basename(raw))
      next if File.exist?(dest)

      FileUtils.cp(raw, dest)
      UI.message("Store unframed (no device frame): #{File.basename(dest)}")
    end
  end

  private_lane :fit_screenshots_to_app_store_sizes do
    iphone_size = [1320, 2868]
    ipad_size = [2064, 2752]
    background = "#F5EDE4"

    Dir.glob(File.join(SCREENSHOTS_STORE_LOCALE, "*.png")).each do |path|
      next if File.basename(path).start_with?(".")

      target =
        if path.match?(/iPad/i)
          ipad_size
        elsif path.match?(/iPhone/i)
          iphone_size
        else
          UI.important("Skipping size fit (unknown device): #{path}")
          next
        end

      width, height = target
      tool = `which magick`.strip
      tool = `which convert`.strip if tool.empty?
      cmd = [
        tool,
        path.shellescape,
        "-resize", "#{width}x#{height}",
        "-background", background.shellescape,
        "-gravity", "center",
        "-extent", "#{width}x#{height}",
        path.shellescape
      ].join(" ")
      sh(cmd)
      UI.message("Fitted #{File.basename(path)} → #{width}x#{height}")
    end
  end
end
